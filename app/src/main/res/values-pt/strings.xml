    <string name="version_fmt">Versão %1$s</string>
    <string name="based_on_handbrake">Baseado no HandBrake</string>
    <string name="about_body">O HandDroid é um conversor de vídeo para Android inspirado no HandBrake. Ele transforma vídeos de quase qualquer codec em arquivos MP4, MKV ou WebM compactos, com as predefinições do HandBrake ou configurações detalhadas suas. As predefinições e a estrutura das configurações vêm do projeto HandBrake; a conversão em si é feita pelo FFmpeg com x264, x265, libvpx e libaom.</string>
    <string name="about_disclaimer">O HandDroid é um projeto independente. Não é afiliado nem endossado pela equipe do HandBrake. HandBrake é © 2003–2026 HandBrake Team.</string>
    <string name="license">Licença</string>
    <string name="license_body">O HandDroid é software livre, lançado sob a GNU General Public License versão 2 (GPL-2.0), a mesma licença do HandBrake. Você pode usá-lo, estudá-lo, compartilhá-lo e modificá-lo conforme os termos dessa licença.</string>
